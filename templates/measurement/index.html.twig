{% extends 'base.html.twig' %}

{% block title %}Measurement index{% endblock %}

{% block body %}
    <h1>Measurement index</h1>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
            <tr>
                <th>Id</th>
                <th>Location</th>
                <th>Date</th>
                <th>Celsius</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.id }}</td>
                    <td>
                        {{ measurement.location ? measurement.location.city : '' }}
                    </td>
                    <td>
                        {{ measurement.date ? measurement.date|date('Y-m-d') : '' }}
                    </td>
                    <td>{{ measurement.celsius }}</td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="{{ path('app_measurement_show', {'id': measurement.id}) }}">
                            Show
                        </a>
                        <a class="btn btn-warning btn-sm"
                           href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">
                            Edit
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a class="btn btn-primary" href="{{ path('app_measurement_new') }}">
        Create new
    </a>
{% endblock %}
